# Random secrets, stored encrypted in SSM Parameter Store.
# "ephemeral" + "value_wo" (write-only) = the values go to AWS but are never
# written to terraform.tfstate, so the state file holds no passwords.

ephemeral "random_password" "grafana_admin" {
  length  = 24
  special = false # letters and digits only: easy to paste, still ~140 bits of randomness
}

ephemeral "random_password" "shop_api_admin_token" {
  length  = 40
  special = false
}

resource "aws_ssm_parameter" "grafana_admin_password" {
  name        = "/${var.project}/grafana-admin-password"
  description = "Grafana 'admin' password (generated by Terraform)"
  type        = "SecureString"

  value_wo         = ephemeral.random_password.grafana_admin.result
  value_wo_version = 1 # bump to 2, 3, ... to generate and store a new password
}

resource "aws_ssm_parameter" "shop_api_admin_token" {
  name        = "/${var.project}/shop-api-admin-token"
  description = "Bearer token for the shop-api fault-injection endpoint (generated by Terraform)"
  type        = "SecureString"

  value_wo         = ephemeral.random_password.shop_api_admin_token.result
  value_wo_version = 1
}
