# Rendered by Ansible on the server - edit stack/ansible/roles/stack/templates/alertmanager.yml.j2 instead.
# Same routing as alertmanager.local.yml, plus e-mail delivery through Amazon SNS.
templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: email
  group_by: [alertname, slo, service]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="page"']
      repeat_interval: 1h
    - matchers: ['severity="ticket"']
      repeat_interval: 12h

receivers:
  - name: email
    sns_configs:
      # Signed with the EC2 instance role (no access keys anywhere).
      - topic_arn: {{ sns_topic_arn }}
        sigv4:
          region: {{ aws_region }}
        send_resolved: true

inhibit_rules:
  # While an SLO is paging, don't also send the (slower) ticket for the same SLO.
  - source_matchers: ['severity="page"']
    target_matchers: ['severity="ticket"']
    equal: [slo]
